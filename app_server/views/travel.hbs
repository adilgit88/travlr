<div class="box">
  <div>
    <div class="body">
      <h1>Travel Packages</h1>
      <ul id="sites">
        {{#each trips}}
        <li>
          <a href="/travel"><img src="/images/{{this.image}}" alt="{{this.name}}"></a>
          <h2><a href="/travel">{{this.name}}</a></h2>
          <p>{{this.description}}</p>
          <p><strong>Start:</strong> {{this.start}} &nbsp;|&nbsp;
             <strong>Length:</strong> {{this.length}} &nbsp;|&nbsp;
             <strong>Resort:</strong> {{this.resort}} &nbsp;|&nbsp;
             <strong>Per Person:</strong> ${{this.perPerson}}</p>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
