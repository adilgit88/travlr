<div id="contents">
	<div class="box">
		<div>
			<div class="body">
				<h1>Travel</h1>
				<ul id="sites">
					{{#each trips}}
						<li>
							<a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
							<h2><a href="/travel">{{name}}</a></h2>
							<p>
								<strong>{{length}}</strong> at {{resort}} starting {{start}}.
							</p>
							<p>
								{{description}}
							</p>
							<p>
								<strong>${{perPerson}} per person</strong>
							</p>
						</li>
					{{/each}}
				</ul>
			</div>
		</div>
	</div>
</div>
